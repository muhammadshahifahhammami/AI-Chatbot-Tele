      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: sans-serif; background: #f4f6f8; padding: 40px; }\n    .invoice-wrapper { max-width: 800px; margin: auto; background: #fff; padding: 40px; border-radius: 8px; }\n    .header { display: flex; justify-content: space-between; border-bottom: 2px solid #eee; padding-bottom: 20px; }\n    .section { margin: 20px 0; }\n    table { width: 100%; border-collapse: collapse; }\n    th { background: #f9fafb; padding: 12px; text-align: left; border-bottom: 2px solid #eee; }\n    td { padding: 12px; border-bottom: 1px solid #eee; }\n    .total { text-align: right; font-weight: bold; font-size: 18px; margin-top: 20px; }\n  </style>\n</head>\n<body>\n  <div class=\"invoice-wrapper\">\n    <div class=\"header\">\n      <h1>INVOICE</h1>\n      <div>\n        <p>Tanggal: {{ $now.format('dd/MM/yyyy') }}</p>\n        <p>Jatuh Tempo: {{ $now.plus({ days: 25 }).format('dd/MM/yyyy') }}</p>\n        <p>No: INV-{{ $execution.id }}</p>\n      </div>\n    </div>\n\n    <div class=\"section\">\n      <strong>Ditagihkan Kepada:</strong>\n      <p>{{ $node[\"Edit Fields\"].json[\"client_name\"] }}</p>\n      <p>{{ $node[\"Edit Fields\"].json[\"client_email\"] }}</p>\n    </div>\n\n    <table>\n      <thead>\n        <tr>\n          <th>Deskripsi</th>\n          <th>Jam</th>\n          <th>Rate</th>\n          <th>Subtotal</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>Jasa Pekerjaan / Konsultasi</td>\n          <td>{{ $node[\"Edit Fields\"].json[\"hours\"] }}</td>\n          <td>Rp {{ $node[\"Edit Fields\"].json[\"rate\"].toLocaleString('id-ID') }}</td>\n          <td>Rp {{ $node[\"Edit Fields\"].json[\"total_cost\"].toLocaleString('id-ID') }}</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <div class=\"total\">\n      Total Tagihan: Rp {{ $node[\"Edit Fields\"].json[\"total_cost\"].toLocaleString('id-ID') }}\n    </div>\n  </div>\n</body>\n</html>"
